{
  "format": ["java", "kotlin"],
  "minLines": 6,
  "minTokens": 60,
  "gitignore": true,
  "ignore": [
    "**/build/**",
    "**/.gradle/**",
    "**/jscpd-report/**"
  ],
  "ignorePattern": [
    "(?m)^[ \\t]*(?:package|import)[ \\t][^\\r\\n]*"
  ],
  "reporters": ["console", "html"],
  "output": "./jscpd-report"
}
